#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
fp_venv
python -c "import PyInstaller" 2>/dev/null || fp_die "PyInstaller missing, run ./formpdf install-desktop"
triple="$(fp_target_triple)" || fp_die "rustc not found; install Rust or set FORMPDF_TARGET"
[ -f "$FORMPDF_ROOT/frontend/dist/index.html" ] || "$FORMPDF_ROOT/setup/build_frontend"
cd "$FORMPDF_ROOT/backend"
sep=":"
[ "$(fp_os)" = windows ] && sep=";"
ext="$(fp_exe)"
extra=()
if [ -d "$FORMPDF_ROOT/backend/app/fonts" ]; then extra+=(--add-data "$(fp_native_path "$FORMPDF_ROOT/backend/app/fonts")${sep}fonts"); fi
if [ -d "$FORMPDF_ROOT/backend/app/dict" ]; then extra+=(--add-data "$(fp_native_path "$FORMPDF_ROOT/backend/app/dict")${sep}dict"); fi
extra+=(--hidden-import ptyprocess)
if python -c "import winpty" 2>/dev/null; then extra+=(--hidden-import winpty); fi
release_ocr=""
no_ocr=""
[ -n "${FORMCOMPILER_VERSION:-}" ] && [ "${FORMPDF_NO_OCR:-}" != "1" ] && release_ocr=1
if [ -n "$release_ocr" ]; then
  python -c "import rapidocr, onnxruntime, shapely, pyclipper, cv2" || fp_die "a release build must bundle text recognition (OCR) and its modules are missing; run ./formpdf install"
fi
if [ "$(fp_os)" = macos ]; then
  gpl="$(python -c 'import pathlib, cv2; print("\n".join(str(p) for p in pathlib.Path(cv2.__file__).parent.rglob("*") if any(k in p.name.lower() for k in ("libx264", "libx265", "librubberband", "libvidstab", "libpostproc"))))' 2>/dev/null | head -1)"
  if [ -n "$gpl" ]; then
    rebuild="cd backend && PIP_NO_BINARY=opencv-python,opencv-python-headless CMAKE_ARGS=\"-DWITH_FFMPEG=OFF -DWITH_GSTREAMER=OFF -DWITH_OPENEXR=OFF -DWITH_VTK=OFF -DWITH_QT=OFF -DWITH_GTK=OFF -DWITH_EIGEN=OFF\" CMAKE_BUILD_PARALLEL_LEVEL=4 venv/bin/pip install --force-reinstall -r requirements_ocr.txt"
    [ -z "${FORMCOMPILER_VERSION:-}" ] || fp_die "GPL FFmpeg library in OpenCV: $gpl. Reinstall opencv from source without FFmpeg (about 25 minutes): $rebuild"
    fp_say "OpenCV here carries GPL FFmpeg ($gpl), so this sidecar is frozen without text recognition (OCR); everything else works."
    fp_say "To put OCR back, rebuild OpenCV from source without FFmpeg (about 25 minutes), then rerun setup/freeze_backend: $rebuild"
    no_ocr=1
  fi
fi
if [ -n "$no_ocr" ]; then
  extra+=(--exclude-module cv2 --exclude-module rapidocr --exclude-module onnxruntime)
elif python -c "import rapidocr, onnxruntime" 2>/dev/null; then
  extra+=(--collect-all rapidocr --collect-all onnxruntime --collect-all shapely --collect-all pyclipper)
fi
rm -rf build/pyinstaller dist-engine
pyinstaller --noconfirm --clean --onefile --name formpdf-engine \
  --distpath dist-engine --workpath build/pyinstaller --specpath build/pyinstaller \
  --add-data "$(fp_native_path "$FORMPDF_ROOT/frontend/dist")${sep}frontend_dist" \
  --collect-submodules app --collect-submodules uvicorn --collect-submodules fontTools \
  --collect-all pptx --collect-all pdfplumber --hidden-import pypdfium2 --collect-all pyhanko --collect-all pyhanko_certvalidator \
  "${extra[@]}" \
  "$(fp_native_path "$FORMPDF_ROOT/backend/formpdf_engine.py")"
mkdir -p "$FORMPDF_ROOT/src-tauri/binaries"
out="$FORMPDF_ROOT/src-tauri/binaries/formpdf-engine-${triple}${ext}"
cp "dist-engine/formpdf-engine${ext}" "$out"
check="$("$out" --selfcheck)"
printf '%s\n' "$check"
if [ -n "$release_ocr" ]; then
  printf '%s\n' "$check" | python -c 'import json, sys; raise SystemExit(0 if json.loads(sys.stdin.read().strip().splitlines()[-1]).get("ocr") is True else 1)' || fp_die "the frozen engine reports text recognition (OCR) unavailable, and a release build must ship it"
fi
fp_say "sidecar ready: $out"
