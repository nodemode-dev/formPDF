#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
fp_venv
python -c "import PyInstaller" 2>/dev/null || fp_die "PyInstaller missing, run ./formpdf install-desktop"
triple="$(fp_target_triple)" || fp_die "rustc not found; install Rust or set FORMPDF_TARGET"
[ -f "$FORMPDF_ROOT/frontend/dist/index.html" ] || "$FORMPDF_ROOT/setup/build_frontend"
cd "$FORMPDF_ROOT/backend"
sep=":"
[ "$(fp_os)" = windows ] && sep=";"
ext="$(fp_exe)"
extra=()
if [ -d "$FORMPDF_ROOT/backend/app/fonts" ]; then extra+=(--add-data "$FORMPDF_ROOT/backend/app/fonts${sep}fonts"); fi
if [ -d "$FORMPDF_ROOT/backend/app/dict" ]; then extra+=(--add-data "$FORMPDF_ROOT/backend/app/dict${sep}dict"); fi
extra+=(--hidden-import ptyprocess)
if python -c "import winpty" 2>/dev/null; then extra+=(--hidden-import winpty); fi
if python -c "import rapidocr, onnxruntime" 2>/dev/null; then extra+=(--collect-all rapidocr --collect-all onnxruntime --collect-all shapely --collect-all pyclipper); fi
if [ "$(fp_os)" = macos ]; then
  gpl="$(python -c 'import pathlib, cv2; print("\n".join(str(p) for p in pathlib.Path(cv2.__file__).parent.rglob("*") if any(k in p.name.lower() for k in ("libx264", "libx265", "librubberband", "libvidstab", "libpostproc"))))' 2>/dev/null | head -1)"
  [ -z "$gpl" ] || fp_die "GPL FFmpeg library in OpenCV: $gpl. Reinstall opencv from source without FFmpeg: PIP_NO_BINARY=opencv-python,opencv-python-headless CMAKE_ARGS=-DWITH_FFMPEG=OFF pip install --force-reinstall -r requirements_ocr.txt"
fi
rm -rf build/pyinstaller dist-engine
pyinstaller --noconfirm --clean --onefile --name formpdf-engine \
  --distpath dist-engine --workpath build/pyinstaller --specpath build/pyinstaller \
  --add-data "$FORMPDF_ROOT/frontend/dist${sep}frontend_dist" \
  --collect-submodules app --collect-submodules uvicorn --collect-submodules fontTools \
  --collect-all pptx --collect-all pdfplumber --hidden-import pypdfium2 --collect-all pyhanko --collect-all pyhanko_certvalidator \
  "${extra[@]}" \
  "$FORMPDF_ROOT/backend/formpdf_engine.py"
mkdir -p "$FORMPDF_ROOT/src-tauri/binaries"
out="$FORMPDF_ROOT/src-tauri/binaries/formpdf-engine-${triple}${ext}"
cp "dist-engine/formpdf-engine${ext}" "$out"
"$out" --selfcheck
fp_say "sidecar ready: $out"
