#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
cd "$FORMPDF_ROOT"
pids=()
( cd backend && ./boot_backend ) &
pids+=($!)
( cd frontend && ./boot_frontend ) &
pids+=($!)
trap 'kill "${pids[@]}" 2>/dev/null' EXIT INT TERM
fp_say "frontend http://localhost:5198 · backend http://127.0.0.1:${FORMPDF_PORT:-8198}"
wait
